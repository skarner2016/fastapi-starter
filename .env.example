# App Configuration
APP_ENV=dev
APP_NAME=fastapi-starter
APP_VERSION=0.1.0
APP_TIMEZONE=Asia/Shanghai
APP_TIMEOUT=6

# Log Configuration
LOG_LEVEL=info
LOG_DIR=runtime/logs
SQL_LOG=False


# MySQL Configuration
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=123456
MYSQL_DATABASE=tools
MYSQL_POOL_SIZE=10
MYSQL_POOL_RECYCLE=3600

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
